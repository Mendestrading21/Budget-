{
  "modeles": {
    "Account": [
      "@Attribute(.unique) var id: UUID",
      "var name: String",
      "var institutionName: String",
      "var typeRawValue: String",
      "var currencyCode: String",
      "var openingBalance: Decimal",
      "var reconciledBalance: Decimal?",
      "var reconciledAt: Date?",
      "var isShared: Bool",
      "var isActive: Bool",
      "var includeInAvailableCash: Bool",
      "var includeInNetWorth: Bool",
      "var createdAt: Date",
      "var updatedAt: Date",
      "var owner: HouseholdMember?",
      "@Relationship(deleteRule: .deny, inverse: \\BudgetTransaction.account) var transactions: [BudgetTransaction]",
      "@Relationship(deleteRule: .deny, inverse: \\BudgetTransaction.destinationAccount) var incomingMovements: [BudgetTransaction]"
    ],
    "BrokeragePosition": [
      "@Attribute(.unique) var id: UUID",
      "var instrumentName: String",
      "var tickerOrISIN: String?",
      "var quantity: Decimal",
      "var manualPrice: Decimal",
      "var priceCurrency: String",
      "var valuationDate: Date",
      "var costBasis: Decimal?",
      "var createdAt: Date",
      "var updatedAt: Date",
      "var account: Account?"
    ],
    "BudgetCategory": [
      "@Attribute(.unique) var id: UUID",
      "var name: String",
      "var kindRawValue: String",
      "var iconToken: String",
      "var emoji: String?",
