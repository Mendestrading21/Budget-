      "var createdAt: Date",
      "var updatedAt: Date",
      "var account: Account?",
      "var destinationAccount: Account?",
      "var category: BudgetCategory?",
      "var member: HouseholdMember?"
    ],
    "FinancialDocument": [
      "@Attribute(.unique) var id: UUID",
      "var title: String",
      "var kindRawValue: String",
      "var year: Int?",
