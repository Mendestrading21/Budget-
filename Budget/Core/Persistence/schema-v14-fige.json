      "var isActive: Bool",
      "var sortOrder: Int",
      "var parent: BudgetCategory?",
      "@Relationship(deleteRule: .cascade, inverse: \\BudgetCategory.parent) var children: [BudgetCategory]"
    ],
    "BudgetTransaction": [
      "@Attribute(.unique) var id: UUID",
      "var date: Date",
      "var amount: Decimal",
      "var typeRawValue: String",
