      "var note: String?",
      "var fileReference: String",
      "var fileSizeBytes: Int?",
      "var addedAt: Date",
      "var updatedAt: Date",
      "var member: HouseholdMember?"
    ],
    "ImportBatch": [
      "@Attribute(.unique) var id: UUID",
      "var fileName: String",
      "var importedAt: Date",
      "var totalRows: Int",
